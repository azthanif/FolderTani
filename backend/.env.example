# Salin ke backend/.env untuk development lokal (JANGAN di-commit). Dibaca otomatis saat backend start.
# Di Vercel, isi lewat Project Settings > Environment Variables.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
TEMUTANI_SECRET=string-acak-panjang
TEMUTANI_OTP_DEV=1
# WhatsApp (opsional di lokal)
WAHA_URL=
WAHA_SESSION=default
WAHA_API_KEY=
# Berita: csv (default) atau supabase
TEMUTANI_NEWS_SOURCE=supabase
SUPABASE_URL=https://synglxgrlpdfbjadmbfu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Escrow (Xendit test mode) - lihat backend/escrow.py & backend/xendit.py
XENDIT_SECRET_KEY=xnd_development_...
XENDIT_CALLBACK_TOKEN=
# 1 = simulasi tanpa akun Xendit (admin menggerakkan status lewat /api/escrow/{id}/simulasi). Jangan aktif bila kunci Xendit sudah diisi.
TEMUTANI_PAYMENT_MOCK=
ESCROW_INVOICE_HOURS=24
# Fee aplikasi (% dari nilai gabah), PRD delivery; default 0.5
ESCROW_FEE_PERSEN=0.5
# Token layanan n8n <-> backend (isi nilai acak yang sama di env n8n)
TEMUTANI_SERVICE_TOKEN=string-acak-panjang
# Webhook workflow "temu tani escrow"; kosong = notifikasi langsung lewat WAHA
N8N_ESCROW_WEBHOOK_URL=http://n8n:5678/webhook/temutani-escrow
# Rahasia header ke webhook n8n (BERBEDA dari TEMUTANI_SERVICE_TOKEN); isi nilai yang sama di env n8n
N8N_ESCROW_WEBHOOK_TOKEN=string-acak-lain
